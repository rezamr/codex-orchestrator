{
  "name": "codex-orchestrator",
  "version": "0.1.0-alpha.0",
  "description": "Desktop-first open-source orchestration layer for long-running Codex work.",
  "author": "rezamr",
  "repository": {
    "type": "git",
    "url": "https://github.com/rezamr/codex-orchestrator.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "openspec:init": "npx @fission-ai/openspec@latest init --tools codex",
    "openspec:update": "npx @fission-ai/openspec@latest update",
    "openspec:list": "npx @fission-ai/openspec@latest list",
    "assets:generate": "node scripts/generate-icons.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/e2e/**",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:e2e && npm run build",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openspec:validate": "npx -y @fission-ai/openspec@latest validate --all --strict --no-interactive",
    "openspec:status": "npx -y @fission-ai/openspec@latest status --all",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.14.5",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.2",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "build": {
    "appId": "io.github.rezamr.codex-orchestrator",
    "productName": "Codex Orchestrator",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
